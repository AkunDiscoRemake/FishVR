{
  "name": "perfect-fishing-vr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PERFECT FISHING VR - WebXR/WebVR/Cardboard fishing game with Supabase multiplayer",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test tests/*.test.js",
    "test:functions": "cd supabase/functions && deno test --allow-env --allow-read --import-map=_tests/import_map.json _tests/functions_test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "three": "0.162.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "vite": "6.3.5"
  }
}
